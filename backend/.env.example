# ─── Required ──────────────────────────────────────────────────────────────────

# Secret for the admin endpoint POST /admin/entities/:id/verify
# Used to approve entity verification requests and assign authorized wallets
ADMIN_SECRET=change-me-to-a-long-random-string

# Address that receives USDC payments on x402 calls
PAY_TO=0x...

# Thirdweb secret key — used only to format the 402 challenge header.
# Get one at https://thirdweb.com/dashboard
THIRDWEB_SECRET_KEY=...

# EOA wallet that executes transferWithAuthorization on-chain (settlement).
# Must hold native gas tokens on each supported network:
#   Base/Arbitrum → ETH   Celo → CELO   Polygon → MATIC
# A few dollars of ETH covers thousands of settlements on Base.
SETTLER_PRIVATE_KEY=0x...

# Supabase project (uses REST API, no direct DB connection)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SECRET_KEY=...

# ─── Optional ──────────────────────────────────────────────────────────────────

# Server port (default: 4022)
PORT=4022

# Bypass x402 for local development (no payment required)
# SKIP_PAYMENT=true

# Networks that accept payment. Comma-separated.
# Supported: base, celo, polygon, arbitrum
# Change here → backend reads new network automatically.
X402_NETWORKS=base

# Base URL used in issued credential JSON and QR codes
BASE_URL=https://hashproof.dev

# Pinata IPFS: JWT for uploading credential JSON as decentralized backup.
# Without this, credentials are stored only in the database.
PINATA_JWT=...

# Blockchain registration on Celo (CredentialRegistry contract)
# Required to register credentials on-chain. Set SKIP_CHAIN=true for local dev.
# Accepts a comma-separated list of RPC URLs for automatic failover.
# When an RPC returns a capacity/rate-limit error, it is blocked for 1h and the
# next one is used. https://forno.celo.org is always added as a last resort.
# Example: CELO_RPC_URL=https://celo-mainnet.g.alchemy.com/v2/KEY1,https://celo-mainnet.g.alchemy.com/v2/KEY2
CELO_RPC_URL=https://forno.celo.org
REGISTRY_CONTRACT_ADDRESS=0x7a1B759A602Aba72a70f99Dffd0a386d7504ce9B
CELOSCAN_API_KEY=your_celoscan_api_key
REGISTRY_PRIVATE_KEY=0x...
# SKIP_CHAIN=true

# Issuance throughput tuning (optional — defaults shown).
# Celo mines ~1s blocks, so ethers' 4000ms default poll dominates tx.wait().
# CELO_POLLING_INTERVAL_MS=500
# register() measures ~131k gas; explicit limit skips an estimate round-trip.
# REGISTRY_GAS_LIMIT=300000
# Give up waiting for a receipt before the CDN cuts the connection at 100s.
# A timeout is followed by direct receipt lookups, so leave room for those.
# REGISTRY_CONFIRM_TIMEOUT_MS=60000
# Reject new issuances with 429 once this many are queued for broadcast, so
# clients get a retryable error instead of a 524 (which they mistake for a
# failure and retry, issuing duplicates). ~110ms each; the proxy cuts at ~25s.
# MAX_ISSUANCE_QUEUE=180

# Async issuance queue (POST /issueCredential with async:true).
# Requires database/migrations/001_issuance_jobs.sql to be applied first.
# Worker concurrency: the on-chain broadcast is serialized behind one wallet, so
# raising this past a handful just queues requests on the same lock.
# ISSUANCE_WORKER_CONCURRENCY=8
# ISSUANCE_WORKER_POLL_MS=1000
# How long a claimed job may run before another instance may reclaim it.
# ISSUANCE_WORKER_LEASE_SECONDS=300
# Set to "false" to run an instance that serves the API but claims no jobs.
# ISSUANCE_WORKER_ENABLED=true
# Telegram alert when the oldest pending job exceeds this age (seconds).
# STUCK_QUEUE_SECONDS=600

# Custom RPC overrides (optional — defaults to public nodes)
# BASE_RPC_URL=https://mainnet.base.org
# POLYGON_RPC_URL=https://polygon-rpc.com
# ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# ─── Monitoring / Cron ─────────────────────────────────────────────────────────

# Telegram bot for health-check alerts (GET /cron/health).
# Create a bot via @BotFather, get chat ID via @userinfobot.
# If not set, alerts are silently skipped.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789

# Enable periodic status reports via Telegram (every 12 hours)
# CRON_STATUS_REPORT=true
